{
  // type-checks the shell against the built packages: `yarn build:shared` and `yarn build:addon`
  // in ayon-frontend first (yarn --cwd addon-dev typecheck:shell)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@ynput/ayon-addon": ["../../addon/dist/types/index.d.ts"],
      "@ynput/ayon-addon/host": ["../../addon/dist/types/host.d.ts"],
      "@ynput/ayon-frontend-shared/*": ["../../shared/dist/types/*.d.ts"]
    }
  },
  "include": ["src"]
}
