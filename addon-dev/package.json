{
  "name": "@ynput/ayon-addon-dev",
  "version": "0.1.0",
  "description": "Dev tooling for AYON addon frontends: Vite plugin, dev server, CLI, lint preset",
  "type": "module",
  "bin": {
    "ayon-addon": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./AGENTS.md": "./AGENTS.md",
    "./shell": "./dist/shell/index.js",
    "./shell/style.css": "./dist/shell/style.css"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js && vite build --config shell/vite.config.ts",
    "typecheck:shell": "tsc -p shell/tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  },
  "peerDependencies": {
    "@module-federation/vite": ">=1.14",
    "@ynput/ayon-addon": "^0.1.0",
    "vite": ">=6",
    "@ynput/ayon-frontend-shared": ">=0.7.0",
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
