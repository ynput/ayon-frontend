{
  "name": "@ynput/ayon-addon-dev",
  "version": "0.1.0",
  "description": "Dev tooling for AYON addon frontends: Vite plugin, dev server, CLI, lint preset",
  "type": "module",
  "bin": {
    "ayon-addon": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./AGENTS.md": "./AGENTS.md"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js"
  },
  "peerDependencies": {
    "@module-federation/vite": ">=1.14",
    "@ynput/ayon-addon": "^0.1.0",
    "vite": ">=6"
  }
}
