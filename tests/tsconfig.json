{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "paths": {
      "@ynput/ayon-e2e": ["../e2e/src/index.ts"],
      "@ynput/ayon-e2e/config": ["../e2e/src/config.ts"]
    }
  },
  "include": ["./e2e/**/*.ts", "../playwright.config.ts"]
}
